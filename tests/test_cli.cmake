if(NOT DEFINED CLI OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "CLI and TEST_ROOT are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(OUT "${TEST_ROOT}/${RUN_ID}")
function(run_expected expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected ${expected}, got ${code}: ${ARGN}\n${stdout}\n${stderr}")
  endif()
endfunction()
run_expected(0 plan --demo 0 --seconds 0 --out "${OUT}/solved")
file(SHA256 "${OUT}/solved/report.json" BEFORE)
run_expected(1 plan --demo 0 --iterations 0 --out "${OUT}/solved")
file(SHA256 "${OUT}/solved/report.json" AFTER)
if(NOT BEFORE STREQUAL AFTER)
  message(FATAL_ERROR "A repeated run overwrote previous evidence")
endif()
run_expected(2 plan --demo 0 --iterations 0 --out "${OUT}/unsolved")
if(EXISTS "${OUT}/unsolved/path.json")
  message(FATAL_ERROR "Unsolved run exported a path")
endif()
foreach(value IN ITEMS -1 42junk 18446744073709551616)
  run_expected(1 plan --seed "${value}" --out "${OUT}/bad-seed")
endforeach()
run_expected(1 plan --planner typo --out "${OUT}/bad-planner")
run_expected(1 plan --seconds 1junk --out "${OUT}/bad-seconds")
run_expected(1 plan --seed)
run_expected(1 plan --typo 1)
file(READ "${OUT}/solved/scene.json" SCENE)
file(WRITE "${OUT}/trailing.json" "${SCENE}\n{}")
run_expected(1 validate-scene --scene "${OUT}/trailing.json")
run_expected(0 validate-path --scene "${OUT}/solved/scene.json" --path "${OUT}/solved/path.json" --step 0.02)
